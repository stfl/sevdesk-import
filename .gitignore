# ---------------------------------------------------------------------------
# Real account data must never be committed. This repository is public.
#
# Deny-by-default: every CSV is ignored wherever it lands, so dropping a fresh
# bank export anywhere in the tree cannot stage it by accident. Synthetic test
# fixtures are re-admitted explicitly, one directory only.
#
# Order matters: git applies the last matching rule, so every deny pattern must
# come before the re-admit at the bottom of this section.
# ---------------------------------------------------------------------------
*.csv

# Statement exports, named defensively in case the rules above are ever relaxed.
revolut-*.csv
wise-*.csv
*-statement*.csv
*konto*.csv
*umsatz*.csv

# Generated output — sevDesk-ready CSVs and run reports derived from real statements.
out/
*.sevdesk.csv
report.json
*.report.json

# The one re-admit, last so it wins over every deny above.
!tests/fixtures/**/*.csv

# Issue tracker: local Dolt database, deliberately not shared.
.beads/

# Rate cache (XDG by default; this covers an in-repo override).
.cache/

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/

# Nix / direnv
result
result-*
.direnv/

# Symlink into the nix store, regenerated by the dev shell on entry.
.pre-commit-config.yaml

# OMC session state (local, regenerated per session)
.omc/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
